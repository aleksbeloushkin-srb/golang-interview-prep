    "tests": "package selectcheck\n\nimport (\n\t\"reflect\"\n\t\"testing\"\n)\n\nfunc TestReceiveStates(t *testing.T) {\n\tempty := make(chan int)\n\tzero := make(chan int, 1)\n\tzero <- 0\n\tclosed := make(chan int)\n\tclose(closed)\n\tbuffered := make(chan int, 1)\n\tbuffered <- 7\n\tclose(buffered)\n\tfor _, tt := range []struct {\n\t\tname         string\n\t\tch           <-chan int\n\t\tvalue        int\n\t\tselected, ok bool\n\t}{\n\t\t{\"nil\", nil, 0, false, false}, {\"empty\", empty, 0, false, false}, {\"zero value\", zero, 0, true, true},\n\t\t{\"closed\", closed, 0, true, false}, {\"closed buffered\", buffered, 7, true, true}, {\"closed drained\", buffered, 0, true, false},\n\t} {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tv, s, ok := TryRecv(tt.ch)\n\t\t\tif v != tt.value || s != tt.selected || ok != tt.ok {\n\t\t\t\tt.Fatalf(\"got %d %v %v\", v, s, ok)\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestSendStates(t *testing.T) {\n\tif TrySend(nil, 1) {\n\t\tt.Fatal(\"nil send selected\")\n\t}\n\tch := make(chan int, 1)\n\tif !TrySend(ch, 7) || TrySend(ch, 8) || <-ch != 7 {\n\t\tt.Fatal(\"buffer readiness\")\n\t}\n}\nfunc TestClosedSendPanics(t *testing.T) {\n\tfor _, general := range []bool{false, true} {\n\t\tt.Run(map[bool]string{false: \"specialized\", true: \"general\"}[general], func(t *testing.T) {\n\t\t\tch := make(chan int)\n\t\t\tclose(ch)\n\t\t\tdefer func() {\n\t\t\t\tif recover() == nil {\n\t\t\t\t\tt.Fatal(\"expected closed-send panic\")\n\t\t\t\t}\n\t\t\t}()\n\t\t\tif general {\n\t\t\t\tSendOrReceive(ch, nil, 1)\n\t\t\t} else {\n\t\t\t\tTrySend(ch, 1)\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestSingleOperations(t *testing.T) {\n\tch := make(chan int)\n\tdone := make(chan struct{})\n\tgo func() { Send(ch, 8); close(done) }()\n\tif Recv(ch) != 8 {\n\t\tt.Fatal(\"single receive\")\n\t}\n\t<-done\n\tclose(ch)\n\tv, ok := RecvOK(ch)\n\tif v != 0 || ok {\n\t\tt.Fatal(\"closed receive\")\n\t}\n\tDiscardRecv(ch)\n\tif DefaultOnly() != 7 {\n\t\tt.Fatal(\"default only\")\n\t}\n}\nfunc TestGeneralAndDuplicateCases(t *testing.T) {\n\tif TwoRecvDefault(nil, nil) != 0 {\n\t\tt.Fatal(\"nil default\")\n\t}\n\tch := make(chan int, 1)\n\tch <- 7\n\tif TwoRecv(nil, ch) != 2 {\n\t\tt.Fatal(\"runtime nil exclusion\")\n\t}\n\tch <- 9\n\tif which := TwoSame(ch); which != 1 && which != 2 {\n\t\tt.Fatal(\"invalid case\")\n\t}\n\tif len(ch) != 0 {\n\t\tt.Fatal(\"duplicate cases must perform one receive\")\n\t}\n\tclose(ch)\n\tif TwoRecvDefault(nil, ch) != 2 {\n\t\tt.Fatal(\"ready receive must beat default\")\n\t}\n}\nfunc TestSendValuesAreEager(t *testing.T) {\n\tfull := make(chan int, 1)\n\tfull <- 7\n\tfor _, ch := range []chan int{nil, full} {\n\t\tcalls := 0\n\t\tif EvalSend(ch, func() int { calls++; return 42 }) || calls != 1 {\n\t\t\tt.Fatal(\"must evaluate once before default\")\n\t\t}\n\t}\n\tdone := make(chan struct{})\n\tclose(done)\n\tcalls := 0\n\tselect {\n\tcase full <- func() int { calls++; return 42 }():\n\t\tt.Fatal(\"send selected\")\n\tcase <-done:\n\t}\n\tif calls != 1 {\n\t\tt.Fatal(\"closed Done cannot skip RHS\")\n\t}\n}\nfunc TestOperandOrder(t *testing.T) {\n\tvar events []string\n\tsend := func(name string) chan int { events = append(events, name); return nil }\n\tvalue := func(name string) int { events = append(events, name); return 1 }\n\tselect {\n\tcase send(\"channel A\") <- value(\"value A\"):\n\tcase send(\"channel B\") <- value(\"value B\"):\n\tdefault:\n\t\tevents = append(events, \"default\")\n\t}\n\twant := []string{\"channel A\", \"value A\", \"channel B\", \"value B\", \"default\"}\n\tif !reflect.DeepEqual(events, want) {\n\t\tt.Fatalf(\"%v\", events)\n\t}\n}\nfunc TestReceiveLHSIsDeferred(t *testing.T) {\n\tcalls := 0\n\tdst := []int{0}\n\tch := make(chan int, 1)\n\tindex := func() int {\n\t\tcalls++\n\t\tif len(ch) != 0 {\n\t\t\tt.Fatal(\"LHS evaluated before communication\")\n\t\t}\n\t\treturn 0\n\t}\n\tif ReceiveLHS(ch, dst, index) || calls != 0 {\n\t\tt.Fatal(\"default must skip receive LHS\")\n\t}\n\tch <- 7\n\tif !ReceiveLHS(ch, dst, index) || calls != 1 || dst[0] != 7 {\n\t\tt.Fatal(\"selected receive assignment\")\n\t}\n}\n",
    "compilerFixture": "package selectcheck\n\nfunc Empty() { select {} }\nfunc DefaultOnly() int {\n\tselect {\n\tdefault:\n\t\treturn 7\n\t}\n}\nfunc Send(ch chan<- int, v int) {\n\tselect {\n\tcase ch <- v:\n\t}\n}\nfunc Recv(ch <-chan int) int {\n\tselect {\n\tcase v := <-ch:\n\t\treturn v\n\t}\n}\nfunc RecvOK(ch <-chan int) (int, bool) {\n\tselect {\n\tcase v, ok := <-ch:\n\t\treturn v, ok\n\t}\n}\nfunc TrySend(ch chan<- int, v int) bool {\n\tselect {\n\tcase ch <- v:\n\t\treturn true\n\tdefault:\n\t\treturn false\n\t}\n}\nfunc TryRecv(ch <-chan int) (value int, selected, ok bool) {\n\tselect {\n\tcase value, ok = <-ch:\n\t\treturn value, true, ok\n\tdefault:\n\t\treturn 0, false, false\n\t}\n}\nfunc TwoRecv(a, b <-chan int) int {\n\tselect {\n\tcase <-a:\n\t\treturn 1\n\tcase <-b:\n\t\treturn 2\n\t}\n}\nfunc TwoRecvDefault(a, b <-chan int) int {\n\tselect {\n\tcase <-a:\n\t\treturn 1\n\tcase <-b:\n\t\treturn 2\n\tdefault:\n\t\treturn 0\n\t}\n}\nfunc SendOrReceive(a chan<- int, b <-chan int, v int) int {\n\tselect {\n\tcase a <- v:\n\t\treturn 1\n\tcase <-b:\n\t\treturn 2\n\tdefault:\n\t\treturn 0\n\t}\n}\nfunc EvalSend(ch chan<- int, build func() int) bool {\n\tselect {\n\tcase ch <- build():\n\t\treturn true\n\tdefault:\n\t\treturn false\n\t}\n}\nfunc ReceiveLHS(ch <-chan int, dst []int, index func() int) bool {\n\tselect {\n\tcase dst[index()] = <-ch:\n\t\treturn true\n\tdefault:\n\t\treturn false\n\t}\n}\nfunc TwoSame(ch <-chan int) int {\n\tselect {\n\tcase <-ch:\n\t\treturn 1\n\tcase <-ch:\n\t\treturn 2\n\t}\n}\n\nfunc DiscardRecv(ch <-chan int) {\n\tselect {\n\tcase <-ch:\n\t}\n}\n"
