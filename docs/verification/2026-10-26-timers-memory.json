      "consume_test.go": "package timercheck\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"testing\"\n\t\"testing/synctest\"\n\t\"time\"\n\toriginal \"timercheck/original\"\n\treuse \"timercheck/reuse\"\n)\n\nfunc TestConsume(t *testing.T) {\n\tfor _, variant := range []struct {\n\t\tname string\n\t\trun  func(context.Context, <-chan int, time.Duration, func(int)) error\n\t\tidle error\n\t}{{\"after\", original.Consume, original.ErrIdle}, {\"reuse\", reuse.Consume, reuse.ErrIdle}} {\n\t\tt.Run(variant.name, func(t *testing.T) {\n\t\t\tt.Run(\"idle\", func(t *testing.T) {\n\t\t\t\tsynctest.Test(t, func(t *testing.T) {\n\t\t\t\t\tstart := time.Now()\n\t\t\t\t\terr := variant.run(context.Background(), nil, time.Minute, func(int) { t.Error(\"unexpected value\") })\n\t\t\t\t\tif !errors.Is(err, variant.idle) || time.Since(start) != time.Minute {\n\t\t\t\t\t\tt.Fatalf(\"err=%v elapsed=%v\", err, time.Since(start))\n\t\t\t\t\t}\n\t\t\t\t})\n\t\t\t})\n\t\t\tt.Run(\"closedDrains\", func(t *testing.T) {\n\t\t\t\tsynctest.Test(t, func(t *testing.T) {\n\t\t\t\t\tin := make(chan int, 2)\n\t\t\t\t\tin <- 3\n\t\t\t\t\tin <- 4\n\t\t\t\t\tclose(in)\n\t\t\t\t\tsum := 0\n\t\t\t\t\terr := variant.run(context.Background(), in, time.Minute, func(v int) { sum += v })\n\t\t\t\t\tif err != nil || sum != 7 {\n\t\t\t\t\t\tt.Fatalf(\"err=%v sum=%d\", err, sum)\n\t\t\t\t\t}\n\t\t\t\t})\n\t\t\t})\n\t\t\tt.Run(\"cancelWhileWaiting\", func(t *testing.T) {\n\t\t\t\tsynctest.Test(t, func(t *testing.T) {\n\t\t\t\t\tctx, cancel := context.WithCancel(context.Background())\n\t\t\t\t\tdefer cancel()\n\t\t\t\t\tdone := make(chan error, 1)\n\t\t\t\t\tgo func() { done <- variant.run(ctx, nil, time.Hour, func(int) { t.Error(\"unexpected value\") }) }()\n\t\t\t\t\tsynctest.Wait()\n\t\t\t\t\tcancel()\n\t\t\t\t\tif err := <-done; !errors.Is(err, context.Canceled) {\n\t\t\t\t\t\tt.Fatal(err)\n\t\t\t\t\t}\n\t\t\t\t})\n\t\t\t})\n\t\t\tt.Run(\"freshWaitAfterSlowHandler\", func(t *testing.T) {\n\t\t\t\tsynctest.Test(t, func(t *testing.T) {\n\t\t\t\t\tin := make(chan int, 1)\n\t\t\t\t\tin <- 1\n\t\t\t\t\tstart := time.Now()\n\t\t\t\t\tcalls := 0\n\t\t\t\t\terr := variant.run(context.Background(), in, time.Minute, func(int) { calls++; time.Sleep(2 * time.Minute) })\n\t\t\t\t\tif !errors.Is(err, variant.idle) || calls != 1 || time.Since(start) != 3*time.Minute {\n\t\t\t\t\t\tt.Fatalf(\"err=%v calls=%d elapsed=%v\", err, calls, time.Since(start))\n\t\t\t\t\t}\n\t\t\t\t})\n\t\t\t})\n\t\t})\n\t}\n}\n\nfunc TestModernResetAndStop(t *testing.T) {\n\tsynctest.Test(t, func(t *testing.T) {\n\t\ttimer := time.NewTimer(time.Second)\n\t\tdefer timer.Stop()\n\t\ttime.Sleep(2 * time.Second)\n\t\tif !timer.Reset(time.Hour) {\n\t\t\tt.Fatal(\"expired but unread modern timer should remain active\")\n\t\t}\n\t\tselect {\n\t\tcase <-timer.C:\n\t\t\tt.Fatal(\"stale time after Reset\")\n\t\tdefault:\n\t\t}\n\t\tstart := time.Now()\n\t\t<-timer.C\n\t\tif time.Since(start) != time.Hour {\n\t\t\tt.Fatal(\"reset deadline\")\n\t\t}\n\t\tif timer.Reset(time.Hour) {\n\t\t\tt.Fatal(\"consumed timer was not active\")\n\t\t}\n\t\tif !timer.Stop() {\n\t\t\tt.Fatal(\"expected active timer\")\n\t\t}\n\t\tselect {\n\t\tcase <-timer.C:\n\t\t\tt.Fatal(\"value after Stop\")\n\t\tdefault:\n\t\t}\n\t})\n}\n\nfunc BenchmarkAfter(b *testing.B) {\n\tb.ReportAllocs()\n\tfor i := 0; i < b.N; i++ {\n\t\tselect {\n\t\tcase <-time.After(time.Hour):\n\t\tdefault:\n\t\t}\n\t}\n}\nfunc BenchmarkReset(b *testing.B) {\n\ttimer := time.NewTimer(time.Hour)\n\tdefer timer.Stop()\n\tb.ReportAllocs()\n\tb.ResetTimer()\n\tfor i := 0; i < b.N; i++ {\n\t\ttimer.Reset(time.Hour)\n\t\tselect {\n\t\tcase <-timer.C:\n\t\tdefault:\n\t\t}\n\t}\n}\n",
      "go.mod": "module timercheck\n\ngo 1.26\n",
      "legacy/go.mod": "module legacytimer\n\ngo 1.22\n",
      "legacy/main.go": "package main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"runtime\"\n\t\"runtime/debug\"\n\t\"time\"\n)\n\nfunc main() {\n\tif len(os.Args) > 1 && os.Args[1] == \"memory\" {\n\t\toldGC := debug.SetGCPercent(-1)\n\t\tdefer debug.SetGCPercent(oldGC)\n\t\toldLimit := debug.SetMemoryLimit(8 << 20)\n\t\tdefer debug.SetMemoryLimit(oldLimit)\n\t\tdata := make([]byte, 16<<20)\n\t\tfor i := range data {\n\t\t\tdata[i] = byte(i)\n\t\t}\n\t\truntime.GC()\n\t\tvar m runtime.MemStats\n\t\truntime.ReadMemStats(&m)\n\t\truntime.KeepAlive(data)\n\t\tif debug.SetMemoryLimit(-1) != 8<<20 || m.Sys-m.HeapReleased <= 8<<20 || m.HeapAlloc < 16<<20 {\n\t\t\tpanic(\"expected retained live allocation above soft limit\")\n\t\t}\n\t\tfmt.Println(\"live data retained above soft limit\")\n\t\treturn\n\t}\n\ttimer := time.NewTimer(time.Hour)\n\tdefer timer.Stop()\n\tfmt.Println(cap(timer.C))\n}\n",
      "original/example.go": "package example\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"time\"\n)\n\nvar ErrIdle = errors.New(\"idle timeout\")\n\nfunc Consume(ctx context.Context, in <-chan int, idle time.Duration, handle func(int)) error {\n\tfor {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn ctx.Err()\n\t\tcase value, ok := <-in:\n\t\t\tif !ok {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\thandle(value)\n\t\tcase <-time.After(idle):\n\t\t\treturn ErrIdle\n\t\t}\n\t}\n}\n",
      "probe/main.go": "package main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"runtime\"\n\t\"runtime/debug\"\n\t\"time\"\n)\n\nfunc main() {\n\tif len(os.Args) > 1 && os.Args[1] == \"memory\" {\n\t\toldGC := debug.SetGCPercent(-1)\n\t\tdefer debug.SetGCPercent(oldGC)\n\t\toldLimit := debug.SetMemoryLimit(8 << 20)\n\t\tdefer debug.SetMemoryLimit(oldLimit)\n\t\tdata := make([]byte, 16<<20)\n\t\tfor i := range data {\n\t\t\tdata[i] = byte(i)\n\t\t}\n\t\truntime.GC()\n\t\tvar m runtime.MemStats\n\t\truntime.ReadMemStats(&m)\n\t\truntime.KeepAlive(data)\n\t\tif debug.SetMemoryLimit(-1) != 8<<20 || m.Sys-m.HeapReleased <= 8<<20 || m.HeapAlloc < 16<<20 {\n\t\t\tpanic(\"expected retained live allocation above soft limit\")\n\t\t}\n\t\tfmt.Println(\"live data retained above soft limit\")\n\t\treturn\n\t}\n\ttimer := time.NewTimer(time.Hour)\n\tdefer timer.Stop()\n\tfmt.Println(cap(timer.C))\n}\n",
      "probe_test.go": "package timercheck\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc runProbe(t *testing.T, dir, setting string, args ...string) string {\n\tt.Helper()\n\tctx, cancel := context.WithTimeout(context.Background(), 45*time.Second)\n\tdefer cancel()\n\tcmd := exec.CommandContext(ctx, \"go\", append([]string{\"run\", \".\"}, args...)...)\n\tcmd.Dir = dir\n\tfor _, v := range os.Environ() {\n\t\tif !strings.HasPrefix(v, \"GODEBUG=\") {\n\t\t\tcmd.Env = append(cmd.Env, v)\n\t\t}\n\t}\n\tcmd.Env = append(cmd.Env, \"GODEBUG=\"+setting)\n\tout, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\tt.Fatalf(\"%v: %s\", err, out)\n\t}\n\treturn strings.TrimSpace(string(out))\n}\nfunc TestTimerCompatibilityModes(t *testing.T) {\n\tfor _, tt := range []struct{ name, dir, setting, want string }{\n\t\t{\"modernDefault\", \"probe\", \"\", \"0\"}, {\"modernForcedOld\", \"probe\", \"asynctimerchan=1\", \"1\"}, {\"modernForcedNew\", \"probe\", \"asynctimerchan=0\", \"0\"},\n\t\t{\"legacyDefault\", \"legacy\", \"\", \"1\"}, {\"legacyForcedNew\", \"legacy\", \"asynctimerchan=0\", \"0\"}, {\"legacyForcedOld\", \"legacy\", \"asynctimerchan=1\", \"1\"},\n\t} {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tif got := runProbe(t, tt.dir, tt.setting); got != tt.want {\n\t\t\t\tt.Fatalf(\"got %s want %s\", got, tt.want)\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestMemoryLimitIsSoft(t *testing.T) {\n\tif got := runProbe(t, \"probe\", \"\", \"memory\"); got != \"live data retained above soft limit\" {\n\t\tt.Fatal(got)\n\t}\n}\n",
      "reuse/example.go": "package example\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"time\"\n)\n\nvar ErrIdle = errors.New(\"idle timeout\")\n\nfunc Consume(ctx context.Context, in <-chan int, idle time.Duration, handle func(int)) error {\n\ttimer := time.NewTimer(idle)\n\tdefer timer.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn ctx.Err()\n\t\tcase value, ok := <-in:\n\t\t\tif !ok {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\thandle(value)\n\t\t\ttimer.Reset(idle)\n\t\tcase <-timer.C:\n\t\t\treturn ErrIdle\n\t\t}\n\t}\n}\n"
