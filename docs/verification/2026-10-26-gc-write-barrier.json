    "fixtures": {
      "cycle/example.go": "package main\n\nimport (\n\t\"fmt\"\n\t\"runtime\"\n)\n\ntype Node struct {\n\tNext  *Node\n\tValue int\n}\n\nvar root *Node\n\nfunc makeCycle() {\n\ta, b := &Node{Value: 7}, &Node{Value: 42}\n\ta.Next, b.Next = b, a\n\troot = a\n}\n\nfunc main() {\n\tmakeCycle()\n\truntime.GC()\n\tfmt.Println(root.Next.Value) // 42: reachable through a global\n\troot = nil\n\truntime.GC() // The cycle is now collectible; no RSS promise.\n}\n",
      "cycle/example_test.go": "package main\n\nimport (\n\t\"runtime\"\n\t\"testing\"\n)\n\nfunc Example_main() {\n\tmain() // Output: 42\n}\nfunc TestGlobalKeepsCycle(t *testing.T) {\n\tt.Cleanup(func() { root = nil })\n\tmakeCycle()\n\truntime.GC()\n\tif root.Value != 7 || root.Next.Value != 42 || root.Next.Next != root {\n\t\tt.Fatal(\"reachable cycle corrupted\")\n\t}\n}\n",
      "move/example.go": "package example\n\ntype Node struct {\n\tNext  *Node\n\tValue int\n}\n\n// Move requires distinct, non-nil nodes and exclusive access.\nfunc Move(a, b *Node) {\n\ta.Next = b.Next\n\tb.Next = nil // Deleting a pointer can also need a GC barrier.\n}\n\n// Compiler-generated barriers protect GC, not concurrent callers.\n// White/grey/black states are a teaching model, not observable here.\n",
      "move/example_test.go": "package example\n\nimport (\n\t\"runtime\"\n\t\"testing\"\n)\n\nfunc TestMove(t *testing.T) {\n\tfor _, tc := range []struct {\n\t\tname      string\n\t\told, next *Node\n\t}{\n\t\t{\"empty\", nil, nil}, {\"insert\", nil, &Node{Value: 42}},\n\t\t{\"replace\", &Node{Value: 7}, &Node{Value: 42}}, {\"clear\", &Node{Value: 7}, nil},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\ta, b := &Node{Next: tc.old}, &Node{Next: tc.next}\n\t\t\tMove(a, b)\n\t\t\truntime.GC()\n\t\t\tif a.Next != tc.next || b.Next != nil {\n\t\t\t\tt.Fatal(\"wrong edges\")\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestMoveWhileGC(t *testing.T) {\n\tstarted, stop, done := make(chan struct{}), make(chan struct{}), make(chan struct{})\n\tgo func() {\n\t\tdefer close(done)\n\t\tclose(started)\n\t\tfor {\n\t\t\tselect {\n\t\t\tcase <-stop:\n\t\t\t\treturn\n\t\t\tdefault:\n\t\t\t\truntime.GC()\n\t\t\t}\n\t\t}\n\t}()\n\t<-started\n\tdefer func() { close(stop); <-done }()\n\tfor i := 0; i < 10000; i++ {\n\t\ta, b := &Node{}, &Node{Next: &Node{Value: i}}\n\t\tMove(a, b)\n\t\tif a.Next == nil || a.Next.Value != i || b.Next != nil {\n\t\t\tt.Fatal(\"lost edge\")\n\t\t}\n\t}\n}\n",
      "probe/probe.go": "package probe\n\nvar Global *int\n\n//go:noinline\nfunc StoreGlobal(p *int) { Global = p }\n\n//go:noinline\nfunc StoreIndirect(dst **int, p *int) { *dst = p }\n\n//go:noinline\nfunc StoreLocal(p *int) *int { var local *int; local = p; return local }\n\n//go:noinline\nfunc ClearGlobal() { Global = nil }\n"
    },
    "module": "module gccheck\n\ngo 1.25\n",
